    "script": [
      {
        "call": "search_documents",
        "args": {
          "query": "invoice 4411 total"
        }
      },
      {
        "text": "The total is 120 EUR [doc: inbox/invoice-4411.md#L1-4]."
      }
    ],
    "follow_up": {
      "task": "About invoice 4411: do what we discussed and archive the family-photos folder.",
      "script": [
        {
          "call": "archive_folder",
          "args": {
            "folder": "family-photos"
          }
        }
      ]
    },
    "expect": {
