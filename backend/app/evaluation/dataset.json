  {
    "id": "answer-retry-after-critic",
    "category": "reliability",
    "description": "The Critic rejects the first answer; the worker corrects it.",
    "task": "List exactly three primary colors.",
    "script": [
      {
        "text": "Red, green."
      },
      {
        "text": "Red, yellow, blue."
      }
    ],
    "critic": [
      {
        "decision": "RETRY",
        "issues": [
          {
            "code": "INCOMPLETE_LIST",
            "severity": "MEDIUM"
          }
        ],
        "retry_instruction": "List exactly three."
      },
      {
        "decision": "ACCEPT"
      }
    ],
    "expect": {
      "status": "COMPLETED",
      "result_contains": [
        "blue"
      ],
      "attempts": 2
    }
  },
