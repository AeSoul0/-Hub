{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AEHub",
  "version": "1.0.0",
  "identifier": "com.aesoul.aehub",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "resources/": "resources/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzREU1OTNBMkVDQzI0RjkKUldUNUpNd3VPbG5lTThvbytQYkpGU3hMVVlaM1hSeVN5cE1DMS9vT2w4S3d2cU9paFpTQ1pWSFgK",
      "endpoints": [
        "https://github.com/AeSoul0/-Hub/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
